{
  "manifest_version": 3,
  "name": "ocha-YTdl",
  "version": "0.9.3",
  "description": "Download YouTube videos — pure JS, no external tools",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "https://jnn-pa.googleapis.com/*",
    "https://raw.githubusercontent.com/0ch4/ocha-YTdl/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/config/youtube.js", "src/shared/maintenance.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ocha-YTdl",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "sandbox": {
    "pages": ["sandbox/solver.html", "sandbox/muxer.html"]
  }
}
