{
  "manifest_version": 3,
  "name": "ocha-YTdl",
  "version": "0.3.4",
  "description": "Download YouTube videos — pure JS, no external tools",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ocha-YTdl"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "sandbox": {
    "pages": ["sandbox/solver.html"]
  }
}
