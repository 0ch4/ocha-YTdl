{
  "manifest_version": 3,
  "name": "ocha-YTdl",
  "version": "0.8.1",
  "description": "Download YouTube videos — pure JS, no external tools",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "https://jnn-pa.googleapis.com/*",
    "https://raw.githubusercontent.com/0ch4/ocha-YTdl/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ocha-YTdl"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "sandbox": {
    "pages": ["sandbox/solver.html", "sandbox/muxer.html", "sandbox/potgen.html"]
  }
}
